{
  "name": "@zoobc/tools",
  "version": "0.1.0",
  "description": "ZooBC keys, addresses, transaction signing and the zbc-cli command line, for Node and the browser, no runtime dependencies",
  "license": "MIT",
  "author": "ZooBC Foundation and Roberto Capodieci",
  "homepage": "https://github.com/zoobc/tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoobc/tools.git",
    "directory": "ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zbc-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/vectors.test.js",
    "bundle": "node scripts/bundle.mjs",
    "gen": "node scripts/gen-commands.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
