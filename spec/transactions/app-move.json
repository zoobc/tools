{
  "license": "MIT. Copyright (c) 2024-2026 ZooBC Foundation and Roberto Capodieci",
  "name": "AppMove",
  "type": 26,
  "command": "app-move",
  "binary": "zbc-app-move",
  "description": "Submit one move.",
  "sender_key": "sender_privkey",
  "recipient": "none",
  "options": [
    "message",
    "encrypt"
  ],
  "needs_node": false,
  "custom": null,
  "params": [
    {
      "name": "sender_privkey",
      "kind": "privkey",
      "required": true,
      "help": "the signing key: 32-byte Ed25519 seed as 64 hex; '-' or omitted = ZBC_KEY"
    },
    {
      "name": "app_id",
      "kind": "int64",
      "required": true,
      "help": "app id"
    },
    {
      "name": "move_hex",
      "kind": "hexbytes",
      "required": true,
      "help": "move bytes, e.g. tic-tac-toe cell 4 = '04'"
    }
  ],
  "body": [
    {
      "name": "app_id",
      "encoding": "u64le",
      "from": "app_id"
    },
    {
      "name": "move_hex",
      "encoding": "hex16",
      "from": "move_hex"
    }
  ],
  "example": {
    "app_id": "5",
    "move_hex": "04"
  },
  "notes": []
}
