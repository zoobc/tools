{
  "license": "MIT. Copyright (c) 2024-2026 ZooBC Foundation and Roberto Capodieci",
  "name": "ReassignSchedule",
  "type": 31,
  "command": "reassign-schedule",
  "binary": null,
  "description": "Redirect a schedule's future fires to a new recipient.",
  "sender_key": "sender_privkey",
  "recipient": "none",
  "options": [
    "message",
    "encrypt"
  ],
  "needs_node": false,
  "custom": null,
  "params": [
    {
      "name": "sender_privkey",
      "kind": "privkey",
      "required": true,
      "help": "the signing key: 32-byte Ed25519 seed as 64 hex; '-' or omitted = ZBC_KEY"
    },
    {
      "name": "schedule_id",
      "kind": "int64",
      "required": true,
      "help": "schedule id"
    },
    {
      "name": "new_recipient",
      "kind": "address",
      "required": true,
      "help": "new recipient"
    }
  ],
  "body": [
    {
      "name": "schedule_id",
      "encoding": "u64le",
      "from": "schedule_id"
    },
    {
      "name": "new_recipient",
      "encoding": "address",
      "from": "new_recipient"
    }
  ],
  "example": {
    "schedule_id": "11",
    "new_recipient": "ZBC_2BFLEMTU_FO2KWOQT_NC6UMFPE_43ICESVX_DIAWXL4F_ECRTFSLX_Q43UIV2I"
  },
  "notes": []
}
