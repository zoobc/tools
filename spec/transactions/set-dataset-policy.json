{
  "license": "MIT. Copyright (c) 2024-2026 ZooBC Foundation and Roberto Capodieci",
  "name": "SetDatasetPolicy",
  "type": 43,
  "command": "set-dataset-policy",
  "binary": null,
  "description": "Set a dataset's mode (owner only): 0 private (only the owner writes), 1 open (anyone writes, each in its own keys), 2 public (anyone writes, one shared key space).",
  "sender_key": "sender_privkey",
  "recipient": "none",
  "options": [
    "message",
    "encrypt"
  ],
  "needs_node": false,
  "custom": null,
  "params": [
    {
      "name": "sender_privkey",
      "kind": "privkey",
      "required": true,
      "help": "the signing key: 32-byte Ed25519 seed as 64 hex; '-' or omitted = ZBC_KEY"
    },
    {
      "name": "object_id",
      "kind": "hex32",
      "required": true,
      "help": "dataset object id"
    },
    {
      "name": "mode",
      "kind": "uint8",
      "required": true,
      "help": "0 private, 1 open, 2 public",
      "min": 0,
      "max": 2
    }
  ],
  "body": [
    {
      "name": "object_id",
      "encoding": "hex",
      "from": "object_id",
      "size": 32
    },
    {
      "name": "mode",
      "encoding": "u8",
      "from": "mode"
    }
  ],
  "example": {
    "object_id": "1111111111111111111111111111111111111111111111111111111111111111",
    "mode": "1"
  },
  "notes": []
}
